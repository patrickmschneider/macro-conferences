{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"array","items":{
  "type":"object","required":["id","name","organizers","topics","source_url","event_start","calls","evidence","last_verified","health"],
  "properties":{
   "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},
   "organizers":{"type":"array","minItems":1,"items":{"type":"string"}},
   "topics":{"type":"array","minItems":1,"items":{"type":"string"}},
   "source_url":{"type":"string","format":"uri","pattern":"^https://"},
   "event_start":{"type":["string","null"],"format":"date"},
   "event_end":{"type":["string","null"],"format":"date"},
   "event_state":{"enum":["announced","cancelled","postponed","completed","unknown"]},
   "health":{"enum":["verified","fetch_failed","needs_verification"]},
   "calls":{"type":"array","items":{"type":"object","required":["id","kind","deadline","state","source_url"],"properties":{
    "id":{"type":"string"},"kind":{"type":"string"},"deadline":{"type":["string","null"],"format":"date"},
    "deadline_time":{"type":["string","null"],"pattern":"^[0-2][0-9]:[0-5][0-9]$"},
    "deadline_timezone":{"type":["string","null"]},"state":{"enum":["open","closed","not_yet_open","unknown","withdrawn"]}
   }}}
  }
 }
}
